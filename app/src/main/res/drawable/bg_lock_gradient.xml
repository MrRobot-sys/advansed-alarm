<?xml version="1.0" encoding="utf-8"?>
<!-- Фон экрана блокировки: глубокая ночь с мягким бликом сверху. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/lock_background"
                android:startColor="#13203D"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.05"
                android:endColor="#00000000"
                android:gradientRadius="420dp"
                android:startColor="@color/lock_background_glow"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
