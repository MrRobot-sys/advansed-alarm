<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Единая дизайн-система приложения: палитра, форма и типографика
        из Material 3. Экраны не задают цвета напрямую, а берут роли темы.
    -->
    <style name="Theme.AdvancedAlarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_container_high</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/on_danger</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Экран блокировки: всегда тёмный, независимо от системной темы. -->
    <style name="Theme.AdvancedAlarm.Lock" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lock_accent</item>
        <item name="colorOnPrimary">@color/lock_background</item>
        <item name="colorPrimaryContainer">@color/lock_surface</item>
        <item name="colorOnPrimaryContainer">@color/lock_text</item>
        <item name="colorSurface">@color/lock_surface</item>
        <item name="colorOnSurface">@color/lock_text</item>
        <item name="colorSurfaceVariant">@color/lock_surface</item>
        <item name="colorOnSurfaceVariant">@color/lock_text_dim</item>
        <item name="colorSecondaryContainer">@color/lock_surface_high</item>
        <item name="colorOnSecondaryContainer">@color/lock_text</item>
        <item name="colorOutline">@color/lock_text_dim</item>
        <item name="colorError">@color/lock_error</item>
        <item name="android:windowBackground">@drawable/bg_lock_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Заголовок экрана. -->
    <style name="TextAppearance.AdvancedAlarm.ScreenTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Крупное время будильника в списке. -->
    <style name="TextAppearance.AdvancedAlarm.AlarmTime" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Цифровое время на экране блокировки. -->
    <style name="TextAppearance.AdvancedAlarm.LockClock" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">84sp</item>
        <item name="android:textColor">@color/lock_text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <!-- Подпись-статус на экране блокировки. -->
    <style name="TextAppearance.AdvancedAlarm.LockStatus" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/lock_accent</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Карточка-секция на экранах настроек и правки. -->
    <style name="Widget.AdvancedAlarm.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>

    <!-- Карточка будильника в списке. -->
    <style name="Widget.AdvancedAlarm.AlarmCard" parent="Widget.AdvancedAlarm.Card">
        <item name="cardCornerRadius">22dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Тихое поле ввода без «коробки»: линия и подпись. -->
    <style name="Widget.AdvancedAlarm.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">?attr/colorOutline</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
