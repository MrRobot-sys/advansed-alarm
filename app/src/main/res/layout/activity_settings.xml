<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_lock_duration"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/lockDurationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_task_count"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/taskCountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_group_window"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/groupWindowInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_ring_duration"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/ringDurationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_emergency_pin"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/emergencyPinInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_working_days"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <CheckBox
                android:id="@+id/workMonday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Пн" />

            <CheckBox
                android:id="@+id/workTuesday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вт" />

            <CheckBox
                android:id="@+id/workWednesday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ср" />

            <CheckBox
                android:id="@+id/workThursday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Чт" />

            <CheckBox
                android:id="@+id/workFriday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Пт" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/hardModeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_hard_mode" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_hard_mode_hint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_allowed_packages"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/allowedPackagesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="com.android.vending"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_allowed_packages_hint"
            android:textSize="12sp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/action_save" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_test_now" />
    </LinearLayout>
</ScrollView>
